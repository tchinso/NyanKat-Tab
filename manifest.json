{
  "manifest_version": 3,
  "name": "NyanKatX3 Tab",
  "version": "1.5.0",
  "description": "New tab redirect, link previews, selected-text translation, subtitle tools, Base64 decoding, floating auto-scroll, and kio.ac download status.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "NyanKatX3 Tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "fontSettings",
    "storage",
    "webNavigation",
    "webRequest",
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["subtitle-extractor.js", "subtitle-probe.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["subtitle-detector.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["link-preview.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["drag-hover-translation.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-zero.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "selection-tools.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "floating-scroll-sites.js",
        "floating-scroll.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "subtitle-parser.js",
        "subtitle-style.js",
        "subtitle-translation.js",
        "subtitle-postprocess.js",
        "subtitle-overlay.js"
      ],
      "css": [
        "subtitle-overlay.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://kone.gg/*",
        "https://*.kone.gg/*"
      ],
      "js": [
        "kone-base64-decoder.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kio.ac/*",
        "https://*.kio.ac/*"
      ],
      "js": [
        "kio-download-watcher.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff", "fonts/*.woff2", "fonts/*.ttf", "subtitle-translation-host.html", "drag-hover-translation-host.html", "drag-hover-translation-settings.html", "link-preview-frame.html", "link-preview-frame.js", "link-preview-frame.css", "link-preview.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_ui": {
    "page": "scroll-settings.html",
    "open_in_tab": true
  }
}
