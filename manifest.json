{
  "manifest_version": 3,
  "name": "NyanKatX3 Tab",
  "version": "1.0.6",
  "description": "New tab redirect, fallback navigation, YouTube start helper, Base64 decoding, and site-specific floating auto-scroll buttons.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "NyanKatX3 Tab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "webNavigation"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube-zero.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "selection-tools.js",
        "floating-scroll.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://kone.gg/*",
        "https://*.kone.gg/*"
      ],
      "js": [
        "kone-base64-decoder.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "scroll-settings.html",
    "open_in_tab": true
  }
}
